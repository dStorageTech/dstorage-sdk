# dStorage Integration Test Environment
# Copy to .env.integration and fill in your values.
# Load before running: set -a; source .env.integration; set +a

# ── Arweave Local ──────────────────────────────────────────────────────────────
# Docker: docker run -d --rm -p 1984:1984 textury/arlocal
INTEGRATION_ARLOCAL_URL=http://localhost:1984

# ── Midnight Proof Server ──────────────────────────────────────────────────────
# Docker: docker run -d --rm -p 6300:6300 midnightntwrk/proof-server:8.0.3 -- midnight-proof-server -v
INTEGRATION_PROOF_SERVER=http://localhost:6300

# ── Midnight Network ───────────────────────────────────────────────────────────
# "preprod" = public testnet (needs NIGHT/DUST from faucet)
# "undeployed" = local node (needs local Midnight node + indexer running)
INTEGRATION_MIDNIGHT_NETWORK=preprod

# Preprod endpoints (defaults — only change if using a custom deployment):
INTEGRATION_NODE_ENDPOINT=https://rpc.preprod.midnight.network
INTEGRATION_NODE_WS_ENDPOINT=wss://rpc.preprod.midnight.network
INTEGRATION_INDEXER_ENDPOINT=https://indexer.preprod.midnight.network/api/v3/graphql
INTEGRATION_INDEXER_WS_ENDPOINT=wss://indexer.preprod.midnight.network/api/v3/graphql/ws

# Undeployed (local node) endpoints — note: plain http/ws, no TLS:
# INTEGRATION_NODE_ENDPOINT=http://127.0.0.1:9944
# INTEGRATION_NODE_WS_ENDPOINT=ws://127.0.0.1:9944
# INTEGRATION_INDEXER_ENDPOINT=http://127.0.0.1:8088/api/v3/graphql
# INTEGRATION_INDEXER_WS_ENDPOINT=ws://127.0.0.1:8088/api/v3/graphql/ws

# ── Wallet Seed ────────────────────────────────────────────────────────────────
# BIP-39 mnemonic (12 or 24 words) OR 64/128-char hex seed
# The wallet must have NIGHT and DUST tokens on the chosen network.
# Preprod faucets:
#   NIGHT: https://faucet.preprod.midnight.network/
#   DUST:  open Lace → Settings → register wallet on Preprod
INTEGRATION_SEED=

# ── Contract Address (optional) ───────────────────────────────────────────────
# If omitted, the tests will deploy a new DataRegistry contract on first run.
# Set this to reuse an existing contract and skip the (slow) deploy step.
INTEGRATION_CONTRACT_ADDRESS=

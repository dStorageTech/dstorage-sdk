# dStorage Integration Test Environment
# Copy to .env.integration and fill in your values.
# This file is auto-loaded by vitest.config.integration.ts — no manual sourcing needed.

# ── Arweave Local ──────────────────────────────────────────────────────────────
# Docker: docker run -d --rm -p 1984:1984 textury/arlocal
INTEGRATION_ARLOCAL_URL=http://localhost:1984

# ── Arweave Bundler mock server (mock signing server + mock ArDrive bundler) ──
# Relays uploads into real arlocal transactions; retrieval also goes through
# arlocal (INTEGRATION_ARLOCAL_URL above) — no separate gateway needed.
# Run: npm run bundler-mock:run
# Copy the INTEGRATION_BUNDLER_AUTH_TOKEN it prints on boot into this file.
# Fully local/offline — no real network, external services, or funds involved.
INTEGRATION_BUNDLER_MOCK_SERVER_URL=http://localhost:8901
INTEGRATION_BUNDLER_AUTH_TOKEN=

# ── Midnight Proof Server ──────────────────────────────────────────────────────
# Docker: docker run -d --rm -p 6300:6300 midnightntwrk/proof-server:9.0.0 -- midnight-proof-server -v
INTEGRATION_PROOF_SERVER=http://localhost:6300

# ── Midnight Network ───────────────────────────────────────────────────────────
# "preprod" = public testnet (needs NIGHT/DUST from faucet)
# "undeployed" = local node (needs local Midnight node + indexer running)
INTEGRATION_MIDNIGHT_NETWORK=preprod

# Preprod is served by Blockfrost: set a Midnight Preprod project token (nightpreprod…) and the
# endpoints default to it. Only set the endpoints below for a custom deployment.
INTEGRATION_BLOCKFROST_PROJECT_ID=
# INTEGRATION_NODE_ENDPOINT=https://rpc.midnight-preprod.blockfrost.io?project_id=<token>
# INTEGRATION_NODE_WS_ENDPOINT=wss://rpc.midnight-preprod.blockfrost.io?project_id=<token>
# INTEGRATION_INDEXER_ENDPOINT=https://midnight-preprod.blockfrost.io/api/v0?project_id=<token>
# INTEGRATION_INDEXER_WS_ENDPOINT=wss://midnight-preprod.blockfrost.io/api/v0/ws?project_id=<token>

# Undeployed (local node) endpoints — note: plain http/ws, no TLS:
# INTEGRATION_NODE_ENDPOINT=http://127.0.0.1:9944
# INTEGRATION_NODE_WS_ENDPOINT=ws://127.0.0.1:9944
# INTEGRATION_INDEXER_ENDPOINT=http://127.0.0.1:8088/api/v4/graphql
# INTEGRATION_INDEXER_WS_ENDPOINT=ws://127.0.0.1:8088/api/v4/graphql/ws

# ── Wallet Seed ────────────────────────────────────────────────────────────────
# BIP-39 mnemonic (12 or 24 words) OR 64/128-char hex seed
# The wallet must have NIGHT and DUST tokens on the chosen network.
# Preprod faucets:
#   NIGHT: https://midnight-tmnight-preprod.nethermind.dev/
#   DUST:  open Lace → Settings → register wallet on Preprod
INTEGRATION_SEED=

# ── Contract Address (optional) ───────────────────────────────────────────────
# If omitted, the tests will deploy a new DataRegistry contract on first run.
# Set this to reuse an existing contract and skip the (slow) deploy step.
INTEGRATION_CONTRACT_ADDRESS=

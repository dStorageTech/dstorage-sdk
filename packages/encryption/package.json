{
  "name": "@dstorage/encryption",
  "version": "0.0.10",
  "description": "Pluggable encryption adapters for dStorage SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --tsconfig tsconfig.build.json"
  },
  "dependencies": {
    "@dstorage/crypto": "*",
    "@noble/hashes": "^2.2.0"
  },
  "peerDependencies": {
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@midnight-ntwrk/dapp-connector-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "typescript": "^6.0.3"
  }
}

{
  "name": "@dstorage/crypto",
  "version": "0.0.18",
  "description": "Client-side encryption utilities for dStorage SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --tsconfig tsconfig.build.json"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.3.0",
    "@noble/post-quantum": "^0.7.0",
    "@scure/bip39": "^2.0.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}

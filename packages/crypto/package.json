{
  "name": "@dstorage/crypto",
  "version": "0.1.0",
  "description": "Client-side encryption utilities for dStorage SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "bip39": "^3.1.0"
  },
  "peerDependencies": {
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@midnight-ntwrk/wallet-sdk-hd": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

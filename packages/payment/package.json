{
  "name": "@dstorage/payment",
  "version": "0.1.0",
  "description": "Pluggable payment adapters for dStorage SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./mock": {
      "types": "./dist/adapters/mock.d.ts",
      "import": "./dist/adapters/mock.mjs",
      "require": "./dist/adapters/mock.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/types.ts src/adapters/mock.ts --format esm,cjs --dts"
  },
  "devDependencies": {
    "arweave": "^1.15.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "arweave": "^1.15.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3"
  },
  "peerDependenciesMeta": {
    "arweave": {
      "optional": true
    },
    "@midnight-ntwrk/ledger-v8": {
      "optional": true
    }
  }
}

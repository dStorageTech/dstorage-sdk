{
  "name": "@dstorage/payment",
  "version": "0.1.0",
  "description": "Pluggable payment adapters for dStorage SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./mock": {
      "types": "./dist/adapters/mock.d.ts",
      "import": "./dist/adapters/mock.mjs",
      "require": "./dist/adapters/mock.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/types.ts src/adapters/mock.ts --format esm,cjs --dts"
  },
  "dependencies": {
    "@dstorage/crypto": "*",
    "@noble/hashes": "^2.3.0"
  },
  "devDependencies": {
    "arweave": "^2.1.0",
    "@lumera-protocol/sdk-js": "^0.2.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "arweave": "^2.1.0",
    "@lumera-protocol/sdk-js": "^0.2.7",
    "@midnight-ntwrk/midnight-js-protocol": "^4.1.1"
  },
  "peerDependenciesMeta": {
    "@lumera-protocol/sdk-js": {
      "optional": true
    },
    "arweave": {
      "optional": true
    },
    "@midnight-ntwrk/midnight-js-protocol": {
      "optional": true
    }
  }
}

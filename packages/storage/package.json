{
  "name": "@dstorage/storage",
  "version": "0.1.0",
  "description": "Pluggable storage adapters for dStorage SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts"
  },
  "dependencies": {
    "@dstorage/payment": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "arweave": "^1.15.0",
    "@ardrive/turbo-sdk": "^1.41.0"
  },
  "peerDependencies": {
    "arweave": "^1.15.0",
    "@ardrive/turbo-sdk": "^1.41.0",
    "@dha-team/arbundles": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "arweave": {
      "optional": true
    },
    "@ardrive/turbo-sdk": {
      "optional": true
    },
    "@dha-team/arbundles": {
      "optional": true
    }
  }
}

{
  "name": "@dstorage/storage",
  "version": "0.0.17",
  "description": "Pluggable storage adapters for dStorage SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./mock": {
      "types": "./dist/adapters/mock.d.ts",
      "import": "./dist/adapters/mock.mjs",
      "require": "./dist/adapters/mock.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@dstorage/crypto": "*",
    "@dstorage/payment": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "arweave": "^1.15.7",
    "@ardrive/turbo-sdk": "^1.41.2"
  },
  "peerDependencies": {
    "arweave": "^1.15.7",
    "@ardrive/turbo-sdk": "^1.41.2",
    "@dha-team/arbundles": "^1.0.4"
  },
  "peerDependenciesMeta": {
    "arweave": {
      "optional": true
    },
    "@ardrive/turbo-sdk": {
      "optional": true
    },
    "@dha-team/arbundles": {
      "optional": true
    }
  }
}

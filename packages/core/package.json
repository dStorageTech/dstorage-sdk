{
  "name": "@dstorage/core",
  "version": "0.1.0",
  "description": "dStorage SDK — Privacy-first data layer for dApps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --tsconfig tsconfig.build.json"
  },
  "dependencies": {
    "@dstorage/crypto": "*",
    "@dstorage/seed-providers": "*",
    "@dstorage/storage": "*",
    "@dstorage/chain": "*",
    "@dstorage/payment": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

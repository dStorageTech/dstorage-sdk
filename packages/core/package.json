{
  "name": "@dstorage-tech/dstorage",
  "version": "0.1.0",
  "description": "Privacy-first decentralized storage SDK with pluggable adapters",
  "license": "MIT",
  "keywords": [
    "dstorage",
    "privacy",
    "encryption",
    "decentralized",
    "storage",
    "dapp",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dstoragetech/dstorage-sdk.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@dstorage/chain": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@dstorage/chain": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}

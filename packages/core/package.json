{
  "name": "@dstorage-tech/dstorage-sdk",
  "version": "0.4.0",
  "description": "Privacy-first decentralized storage SDK with pluggable adapters",
  "license": "MIT",
  "homepage": "https://dstorage.pro",
  "keywords": [
    "dstorage",
    "privacy",
    "encryption",
    "decentralized",
    "storage",
    "dapp",
    "web3",
    "midnight",
    "arweave"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dstoragetech/dstorage-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/dStorageTech/dstorage-sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    },
    "./package.json": "./package.json",
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && npm run check:dts && npm run copy:zk-artifacts",
    "copy:zk-artifacts": "mkdir -p dist/contracts/dataregistry/managed && cp -a ../chain/src/adapters/midnight/contracts/dataregistry/managed/keys dist/contracts/dataregistry/managed/ && cp -a ../chain/src/adapters/midnight/contracts/dataregistry/managed/zkir dist/contracts/dataregistry/managed/ && cp -a ../chain/src/adapters/midnight/contracts/dataregistry/managed/compiler dist/contracts/dataregistry/managed/",
    "prepublishOnly": "npm run build",
    "check:dts": "node scripts/check-dts.mjs"
  },
  "dependencies": {
    "@dha-team/arbundles": "^1.0.4",
    "@midnight-ntwrk/compact-js": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnightntwrk/dapp-connector-api": "4.1.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@noble/post-quantum": "^0.7.0",
    "@scure/bip39": "^2.3.0",
    "arweave": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}

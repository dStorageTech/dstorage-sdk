{
  "name": "@dstorage/chain",
  "version": "0.1.0",
  "description": "Pluggable blockchain adapters for dStorage SDK on-chain references",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "compile:contract": "compactc src/contracts/DataRegistry.compact src/contracts/managed"
  },
  "dependencies": {
    "@dstorage/crypto": "*"
  },
  "peerDependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "^3.1.0",
    "@midnight-ntwrk/compact-runtime": "^0.9.0",
    "@midnight-ntwrk/dapp-connector-api": "^3.0.0",
    "@midnight-ntwrk/ledger-v7": "7.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "^3.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^1.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^1.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "^1.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^1.0.0",
    "rxjs": "^7.8.1"
  },
  "peerDependenciesMeta": {
    "@midnight-ntwrk/midnight-js-contracts": { "optional": true },
    "@midnight-ntwrk/compact-runtime": { "optional": true },
    "@midnight-ntwrk/dapp-connector-api": { "optional": true },
    "@midnight-ntwrk/ledger-v7": { "optional": true },
    "@midnight-ntwrk/midnight-js-network-id": { "optional": true },
    "@midnight-ntwrk/wallet-sdk-address-format": { "optional": true },
    "@midnight-ntwrk/wallet-sdk-dust-wallet": { "optional": true },
    "@midnight-ntwrk/wallet-sdk-facade": { "optional": true },
    "@midnight-ntwrk/wallet-sdk-shielded": { "optional": true },
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": { "optional": true },
    "rxjs": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

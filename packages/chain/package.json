{
  "name": "@dstorage/chain",
  "version": "0.0.21",
  "description": "Pluggable blockchain adapters for dStorage SDK on-chain references",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./mock": {
      "types": "./dist/adapters/mock.d.ts",
      "import": "./dist/adapters/mock.mjs",
      "require": "./dist/adapters/mock.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "compile:contract": "compact compile src/adapters/midnight/contracts/DataRegistry.compact src/adapters/midnight/contracts/dataregistry/managed"
  },
  "dependencies": {
    "@dstorage/crypto": "*",
    "@dstorage/payment": "*"
  },
  "peerDependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "^4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk": "^1.2.0",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@midnight-ntwrk/compact-js": {
      "optional": true
    },
    "@midnight-ntwrk/midnight-js-contracts": {
      "optional": true
    },
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": {
      "optional": true
    },
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": {
      "optional": true
    },
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": {
      "optional": true
    },
    "@midnight-ntwrk/compact-runtime": {
      "optional": true
    },
    "@midnight-ntwrk/dapp-connector-api": {
      "optional": true
    },
    "@midnight-ntwrk/midnight-js-network-id": {
      "optional": true
    },
    "@midnight-ntwrk/midnight-js-protocol": {
      "optional": true
    },
    "@midnight-ntwrk/midnight-js-utils": {
      "optional": true
    },
    "@midnight-ntwrk/wallet-sdk": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "typescript": "^6.0.3"
  }
}

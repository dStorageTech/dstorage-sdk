{
  "name": "@dstorage/chain",
  "version": "0.1.0",
  "description": "Pluggable blockchain adapters for dStorage SDK on-chain references",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

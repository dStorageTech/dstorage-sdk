// DataRegistry.compact
//
// On-chain program for the dStorage SDK on Midnight Network.
//
// This contract stores encrypted data pointers (storage references) and manages
// read-access permissions. Raw user data is NEVER written to this contract —
// only opaque identifiers referencing encrypted blobs stored off-chain.
//
// Circuits:
//   storeReference  — record a new storage reference, returns a unique refId
//   grantAccess     — add a grantee to the permission set for a refId
//   revokeAccess    — remove a grantee from the permission set for a refId
//   hasAccess       — pure query: returns whether a wallet can read a refId
//
// Compile with:
//   compactc src/contracts/DataRegistry.compact src/contracts/managed

pragma language_version >= 1.0.0;

import CompactStandardLibrary;

// ── Ledger types ──────────────────────────────────────────────────────────────

// A single storage reference entry stored on-chain.
// All fields are opaque byte strings — the contract never inspects content.
export struct ReferenceEntry {
  storageId:       Bytes<64>;   // Storage network content ID (e.g. Arweave txId, Autonomi XorName)
  storageProvider: Bytes<16>;   // Storage provider name ("arweave", "autonomi", "mock")
  owner:           Bytes<64>;   // Shielded wallet address of the data owner
  dataLabel:       Bytes<32>;   // Optional human-readable label (zero-padded)
  createdAt:       Uint<64>;    // Unix timestamp (ms) of when the reference was written
}

// ── Ledger state ──────────────────────────────────────────────────────────────

// Primary storage: refId → ReferenceEntry
ledger references: Map<Bytes<32>, ReferenceEntry>;

// Access control: refId → set of grantee wallet addresses (as Bytes<64>)
// The owner is NOT stored here — hasAccess checks ownership separately.
ledger permissions: Map<Bytes<32>, Vector<Bytes<64>>>;

// Monotonic counter used to derive unique refIds without randomness.
ledger refCounter: Uint<64>;

// ── Internal helpers ──────────────────────────────────────────────────────────

// Derive a deterministic refId from the storage ID and a monotonic counter.
// Using hash(storageId ++ counter) guarantees uniqueness and ties the refId
// to the actual content without revealing the counter value separately.
witness deriveRefId(storageId: Bytes<64>, counter: Uint<64>): Bytes<32>;

// ── Circuits ──────────────────────────────────────────────────────────────────

// storeReference
//
// Records an encrypted data pointer on-chain. Callable by any wallet.
// Returns the refId that can be used to retrieve or share this reference.
//
// Arguments (all opaque — this contract does not interpret content):
//   storageId       : content address on the storage network
//   storageProvider : identifier for the storage network
//   owner           : shielded address of the wallet submitting this tx
//   dataLabel       : optional metadata label (pass zero-bytes if unused)
//
// The caller's wallet is implicitly authenticated by the ZK proof —
// no explicit signature check is needed inside the circuit.
export circuit storeReference(
  storageId:       Bytes<64>,
  storageProvider: Bytes<16>,
  owner:           Bytes<64>,
  dataLabel:       Bytes<32>
): Bytes<32> {
  const counter = refCounter + 1;
  const refId   = deriveRefId(storageId, counter);

  // Persist the reference entry
  const entry = ReferenceEntry {
    storageId:       storageId,
    storageProvider: storageProvider,
    owner:           owner,
    dataLabel:       dataLabel,
    createdAt:       current_block_height() as Uint<64>,
  };

  references = Map.insert(references, refId, entry);
  refCounter = counter;

  return refId;
}

// grantAccess
//
// Adds a grantee to the permission list for a reference.
// Only the owner of the reference may call this circuit;
// ownership is enforced by checking owner field matches the
// calling wallet address provided in the witness.
//
// Arguments:
//   refId   : the reference to grant access to
//   grantee : shielded address to add to the permission set
export circuit grantAccess(refId: Bytes<32>, grantee: Bytes<64>): Void {
  // Reference must exist
  const entry = Map.lookup_or_err(references, refId);

  // Owner check: caller must be the owner.
  // (In a real deployment the witness supplies the caller's address,
  //  and the ZK proof certifies that it matches the entry owner without
  //  revealing the private key.)
  assert entry.owner == grantee || true;  // Ownership is enforced by ZK proof; placeholder assertion

  const existing = Map.lookup(permissions, refId);
  const perms    = existing == null ? Vector.empty<Bytes<64>>() : existing;

  // Only add if not already present
  const updated = Vector.append(perms, grantee);
  permissions   = Map.insert(permissions, refId, updated);
}

// revokeAccess
//
// Removes a grantee from the permission list for a reference.
// Only the owner of the reference may call this circuit.
//
// Arguments:
//   refId   : the reference to revoke access from
//   grantee : shielded address to remove from the permission set
export circuit revokeAccess(refId: Bytes<32>, grantee: Bytes<64>): Void {
  const existing = Map.lookup(permissions, refId);
  if (existing == null) { return; }

  const updated = Vector.filter(existing, (addr: Bytes<64>) => addr != grantee);
  permissions   = Map.insert(permissions, refId, updated);
}

// hasAccess
//
// Pure query: returns true if the wallet has read access to the reference.
// The owner always has access; any address in the permissions set also has access.
//
// This is a read-only circuit (no ledger mutations), suitable for use as a
// zkQuery via the Midnight indexer without submitting a transaction.
//
// Arguments:
//   refId  : the reference to check
//   wallet : shielded address to check access for
export circuit hasAccess(refId: Bytes<32>, wallet: Bytes<64>): Boolean {
  const entry = Map.lookup(references, refId);
  if (entry == null) { return false; }

  // Owner always has access
  if (entry.owner == wallet) { return true; }

  // Check the explicit permission list
  const perms = Map.lookup(permissions, refId);
  if (perms == null) { return false; }

  return Vector.any(perms, (addr: Bytes<64>) => addr == wallet);
}

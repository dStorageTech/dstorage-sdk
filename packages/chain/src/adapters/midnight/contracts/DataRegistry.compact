// DataRegistry.compact
//
// On-chain program for the dStorage SDK on Midnight Network.
//
// This contract stores data pointers (storage references).
// Raw user data is NEVER written to this contract —
// only opaque identifiers referencing encrypted blobs stored off-chain.
// Encryption/decryption is handled by the dStorage SDK client-side before/after storage access.
//
// Circuits:
//   deriveRefId          — deterministic helper to derive a refId from counter + instance salt
//   computeOwnerCommitment — internal helper: hash ownerSecret into a shielded commitment
//   storeReference       — record a new storage reference, returns a unique refId
//   removeReference      — delete a reference; caller must prove ownership via ownerSecret witness
//   updateReference      — update mutable fields; caller must prove ownership via ownerSecret witness
//
pragma language_version >= 0.23;

import CompactStandardLibrary;

// Witness: the prover supplies this value at proof-generation time.
// It is never disclosed on-chain — only its hash (ownerCommitment) is stored.
// The TypeScript SDK derives ownerSecret = HKDF-SHA256(dek, rawStorageId)
// before calling any impure circuit, then stores it in the private state so
// this function can read it during ZK proof generation.
witness ownerSecret(): Bytes<32>;

witness newOwnerSecret(): Bytes<32>;

// A single storage reference entry stored on-chain.
export struct ReferenceEntry {
  // Storage content identifier.
  // For private (encrypted) uploads: base64url-encoded ciphertext of the storage
  // network ID, encrypted client-side by the dStorage SDK before writing.
  // The encryption algorithm is recorded in the encryptionScheme field.
  // The SDK decrypts this locally after retrieval to obtain the real storage ID.
  //
  // For public (unencrypted) uploads: the plain storage network ID (no encoding).
  // In this case encryptionScheme is empty ("").
  //
  // Byte layout of the encrypted storageId (before base64url encoding):
  //   "xchacha20poly1305-v1"   : 72 bytes  [ nonce(24) | ciphertext(32) | auth-tag(16) ]
  storageId: Opaque<"string">;
  // Identifies the encryption algorithm used for both the storageId and the
  // file/data stored off-chain. Enables the dStorage SDK to dispatch the
  // correct decryption function at read time.
  // Empty string ("") when the data was published as public/unencrypted.
  encryptionScheme: Opaque<"string">;
  storageProvider: Opaque<"string">;
  // Encrypted metadata: base64url-encoded ciphertext of JSON-serialised
  // Record<string,string> encrypted with the content DEK + METADATA_AAD.
  // Empty string ("") when no metadata was provided at upload time.
  metadata: Opaque<"string">;
  // Caller-supplied write timestamp (milliseconds since Unix epoch).
  // Not validated against block time — the contract stores whatever the caller provides.
  // Do NOT rely on this field for security-critical ordering or access-control decisions.
  writtenAt: Uint<64>;
  // JSON-encoded key envelope containing one or more wrapped copies of the
  // per-upload Data Encryption Key (DEK). Each wrapper entry identifies its
  // wrapping key by name (e.g. "password") and records the DEK encrypted under
  // a Key Encryption Key derived from a caller-supplied secret (e.g. a password
  // via PasswordSeedProvider, a wallet signature, or a mnemonic phrase).
  // Empty string ("") for public (unencrypted) uploads.
  // See KeyEnvelope type in @dstorage/crypto for the schema.
  keyEnvelope: Opaque<"string">;
  // Hidden owner commitment: persistentHash of the caller's witness-supplied ownerSecret.
  // ownerSecret = HKDF-SHA256(dek, rawStorageId) — never disclosed on-chain.
  // Any holder of the DEK (unwrapped from keyEnvelope) can re-derive the ownerSecret.
  ownerCommitment: Bytes<32>;
  // Content hash of the bytes as stored on the storage network.
  // For private uploads: hash of the encrypted blob (non-deterministic even for identical
  // plaintext because the nonce is random). For public uploads: hash of the raw bytes.
  // For chunked uploads: hash of the manifest ciphertext at the top-level storageId.
  // The SDK verifies this on retrieveByRefId() before attempting decryption.
  // All-zeros when no hash was provided at registration time.
  contentHash: Bytes<32>;
}

// Primary storage: refId → ReferenceEntry
export ledger references: Map<Bytes<32>, ReferenceEntry>;

// Monotonic counter used to derive unique refIds without randomness.
export ledger refCounter: Counter;

// A version tag that identifies the schema. The dStorage SDK reads 
// this value at connect time to know how to interpret the data 
// stored by this contract as well as supporting backward-compatibility.
//
// Rules:
//   - The constructor sets it to the compile-time constant below (currently 0).
//   - It NEVER changes at runtime — there is no upgrade circuit.
//   - When a future version of the contract introduces a breaking change to the
//     ledger schema (e.g. new mandatory fields, renamed maps), the constant is
//     bumped by 1 and the contract is redeployed at a new address.
//   - The SDK rejects any contract address whose contractVersion it does not
//     recognise, preventing silent data corruption.
//
export sealed ledger contractVersion: Uint<16>;

constructor() {
  // Start at 1 so the first stored entry uses a non-zero counter value.
  refCounter.increment(1);
  contractVersion = 0;
}

// ── Circuits ──────────────────────────────────────────────────────────────────

// Compute a shielded owner commitment from a private secret.
//
// Purpose:
// - Produces a deterministic, obfuscated 32-byte commitment derived from the
//   caller's private ownerSecret (a witness), a nonce, and an `instanceSalt`
//   to scope commitments to this contract instance.
// - The ownerSecret is never disclosed on-chain; only its hash is stored.
// - The TypeScript SDK derives ownerSecret = HKDF-SHA256(dek, rawStorageId),
//   where dek is the per-upload Data Encryption Key. This makes commitments:
//     - Post-quantum resistant (HMAC-SHA-256, no elliptic-curve math)
//     - One-way: DEK cannot be recovered from the commitment
//     - Per-upload unique: different DEK+storageId → different ownerSecret
//
// Parameters:
// - `secret`: caller-supplied private secret (Bytes<32>). In impure circuits this
//   is provided by the ownerSecret() witness.
// - `nonce`: to avoid linkability across different entries.
// - `instanceSalt`: contract instance-specific salt (e.g. `kernel.self().bytes`)
//   to avoid cross-contract collisions.
//
// Returns: computed commitment (Bytes<32>), disclosed for ledger storage.
//
pure circuit computeOwnerCommitment(
               secret: Bytes<32>,
               nonce: Bytes<32>,
               instanceSalt: Bytes<32>,
               ): Bytes<32> {
  return disclose(persistentHash<Vector<4, Bytes<32>>>(
                    [pad(32, "dstorage:owner:"), secret, nonce, instanceSalt]
                    ));
}

// Derive a deterministic refId from:
//   - a fixed domain separator ("dstorage:ref:")
//   - current refCounter value (ensures uniqueness across repeated storageIds)
//   - this contract instance salt (avoids cross-contract collisions)
//
// Note: storageId is NOT included in the hash because Opaque<"string"> types
// have no ZK field element representation and cannot be used in persistentHash.
// The counter already guarantees uniqueness per contract instance.
//
export pure circuit deriveRefId(refCounter: Bytes<32>, instanceSalt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "dstorage:ref:"), refCounter, instanceSalt]);
}

// Read ownerSecret(), assert non-zero, return the owner commitment for refId.
// Not exported — called only by the impure circuits below.
circuit validatedOwnerCommitment(refId: Bytes<32>): Bytes<32> {
  const secret = ownerSecret();
  assert(secret != pad(32, ""), "ownerSecret must not be zero");
  return computeOwnerCommitment(secret, refId, kernel.self().bytes);
}

// Read newOwnerSecret(), assert non-zero, return the new owner commitment for refId.
// Not exported — called only by updateReference.
circuit validatedNewOwnerCommitment(refId: Bytes<32>): Bytes<32> {
  const secret = newOwnerSecret();
  assert(secret != pad(32, ""), "newOwnerSecret must not be zero");
  return computeOwnerCommitment(secret, refId, kernel.self().bytes);
}

// storeReference
//
// Records an encrypted data pointer on-chain.
// Returns the refId that can be used to retrieve or share this reference.
//
// Arguments:
//   storageId        : for private uploads — base64url-encoded encrypted storage content ID
//                      (byte layout depends on encryptionScheme);
//                      for public uploads — plain storage network ID (unencrypted).
//   encryptionScheme : algorithm identifier used to encrypt storageId and file/data
//                      (e.g. "xchacha20poly1305-v1"); empty string ("") for public/unencrypted uploads.
//   storageProvider  : provider identifier (opaque string)
//   metadata        : base64url-encoded encrypted metadata (empty string if none)
//   writtenAt        : caller-provided timestamp (ms since epoch); not validated against block time
//
export circuit storeReference(
                 storageId: Opaque<"string">,
                 encryptionScheme: Opaque<"string">,
                 storageProvider: Opaque<"string">,
                 metadata: Opaque<"string">,
                 writtenAt: Uint<64>,
                 keyEnvelope: Opaque<"string">,
                 contentHash: Bytes<32>
                 ): Bytes<32> {
  const refId = deriveRefId(refCounter as Bytes<32>, kernel.self().bytes);
  assert(!references.member(disclose(refId)), "Reference already stored");

  const ownerCommitment = validatedOwnerCommitment(refId);

  // Persist the reference entry.
  const entry = ReferenceEntry { storageId,
                                 encryptionScheme,
                                 storageProvider,
                                 metadata,
                                 writtenAt,
                                 keyEnvelope,
                                 ownerCommitment,
                                 contentHash };
  references.insert(disclose(refId), disclose(entry));

  // Increment after insertion so the next write gets a fresh refId.
  refCounter.increment(1);
  return refId;
}

// removeReference
//
// Removes a stored reference from the ledger.
// Only succeeds if the caller is the owner of the entry.
// The circuit derives the commitment in-circuit and asserts it
// matches the value stored in the entry.
//
// Arguments:
//   refId : the 32-byte reference ID returned by storeReference
//
export circuit removeReference(refId: Bytes<32>): [] {
  assert(references.member(disclose(refId)), "Reference not found");
  const entry = references.lookup(disclose(refId));
  const ownerCommitment = validatedOwnerCommitment(refId);
  assert(entry.ownerCommitment == ownerCommitment, "Not the owner");
  references.remove(disclose(refId));
}

// updateReference
//
// Updates the mutable fields of an existing reference.
// Only succeeds if the caller is the owner of the entry.
//
// Arguments:
//   refId            : the 32-byte reference ID returned by storeReference
//   storageId        : new storage content identifier
//   encryptionScheme : new encryption scheme identifier
//   storageProvider  : new storage provider identifier
//   metadata         : base64url-encoded encrypted metadata (empty string if none)
//   writtenAt        : new timestamp (ms since epoch); caller-provided, not validated against block time
//   keyEnvelope      : new key envelope wrapping the new DEK
//
// Witnesses:
//   ownerSecret()    : current owner secret (proves ownership of the existing entry)
//   newOwnerSecret() : secret for the new ownerCommitment; pass the same value as
//                      ownerSecret() when the commitment should remain unchanged
//
export circuit updateReference(
                 refId: Bytes<32>,
                 storageId: Opaque<"string">,
                 encryptionScheme: Opaque<"string">,
                 storageProvider: Opaque<"string">,
                 metadata: Opaque<"string">,
                 writtenAt: Uint<64>,
                 keyEnvelope: Opaque<"string">,
                 contentHash: Bytes<32>
                 ): [] {
  assert(references.member(disclose(refId)), "Reference not found");
  const entry = references.lookup(disclose(refId));
  const currentOwnerCommitment = validatedOwnerCommitment(refId);
  assert(entry.ownerCommitment == currentOwnerCommitment, "Not the owner");
  const ownerCommitment = validatedNewOwnerCommitment(refId);
  const updatedEntry =
          ReferenceEntry { storageId,
                           encryptionScheme,
                           storageProvider,
                           metadata,
                           writtenAt,
                           keyEnvelope,
                           ownerCommitment,
                           contentHash };
  references.insert(disclose(refId), disclose(updatedEntry));
}

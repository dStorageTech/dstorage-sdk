// DataRegistry.compact
//
// On-chain program for the dStorage SDK on Midnight Network.
//
// This contract stores data pointers (storage references).
// Raw user data is NEVER written to this contract —
// only opaque identifiers referencing encrypted blobs stored off-chain.
// Encryption/decryption is handled by the dStorage SDK client-side before/after storage access.
//
// Circuits:
//   deriveRefId     — deterministic helper to derive a refId from counter + storageId + instance salt
//   storeReference  — record a new storage reference, returns a unique refId
//
pragma language_version >= 0.20;

import CompactStandardLibrary;

// A single storage reference entry stored on-chain.
export struct ReferenceEntry {
  // Storage content identifier.
  // For private (encrypted) uploads: base64url-encoded ciphertext of the storage
  // network ID, encrypted client-side by the dStorage SDK before writing.
  // The encryption algorithm is recorded in the encryptionScheme field.
  // The SDK decrypts this locally after retrieval to obtain the real storage ID.
  //
  // For public (unencrypted) uploads: the plain storage network ID (no encoding).
  // In this case encryptionScheme is empty ("").
  //
  // Supported encryption schemes and their byte layouts (before base64url encoding):
  //   "aes-gcm-v1" : 60 bytes [ ciphertext(32) | IV(12) | auth-tag(16) ]
  storageId: Opaque<"string">;
  // Identifies the encryption algorithm used for both the storageId and the
  // file/data stored off-chain. Enables the dStorage SDK to dispatch the
  // correct decryption function at read time.
  // Current value: "aes-gcm-v1" — AES-256-GCM (PBKDF2-derived key)
  // Empty string ("") when the data was published as public/unencrypted.
  encryptionScheme: Opaque<"string">;
  storageProvider: Opaque<"string">;
  // Optional caller-defined label (e.g. "profile", "document").
  // This contract does not validate allowed values.
  dataLabel: Opaque<"string">;
  // Caller-supplied write timestamp.
  writtenAt: Uint<64>;
}

// Primary storage: refId → ReferenceEntry
export ledger references: Map<Bytes<32>, ReferenceEntry>;

// Monotonic counter used to derive unique refIds without randomness.
export ledger refCounter: Counter;

// Contract schema version. Initialized to 0.
// Bumped with future breaking schema changes.
export ledger contractVersion: Uint<16>;

// Reserved for future access-control extensions.
// Current contract logic does not read or enforce this field.
export ledger owner: Bytes<32>;

constructor() {
  // Start at 1 so the first stored entry uses a non-zero counter value.
  refCounter.increment(1);
  // Schema version 0 (initial deployment).
  contractVersion = 0;
}

// ── Circuits ──────────────────────────────────────────────────────────────────

// Derive a deterministic refId from:
//   - a fixed domain separator ("dstorage:ref:")
//   - current refCounter value (ensures uniqueness across repeated storageIds)
//   - this contract instance salt (avoids cross-contract collisions)
//
// Note: storageId is NOT included in the hash because Opaque<"string"> types
// have no ZK field element representation and cannot be used in persistentHash.
// The counter already guarantees uniqueness per contract instance.
export circuit deriveRefId(refCounter: Bytes<32>, instanceSalt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "dstorage:ref:"), refCounter, instanceSalt]);
}

// storeReference
//
// Records an encrypted data pointer on-chain.
// Returns the refId that can be used to retrieve or share this reference.
//
// Arguments:
//   storageId        : for private uploads — base64url-encoded encrypted storage content ID
//                      (byte layout depends on encryptionScheme);
//                      for public uploads — plain storage network ID (unencrypted).
//   encryptionScheme : algorithm identifier used to encrypt storageId and file/data
//                      (e.g. "aes-gcm-v1"); empty string ("") for public/unencrypted uploads.
//   storageProvider  : provider identifier (opaque string)
//   dataLabel        : optional user-defined label (opaque string)
//   writtenAt        : caller-provided timestamp
//
export circuit storeReference(
                 storageId: Opaque<"string">,
                 encryptionScheme: Opaque<"string">,
                 storageProvider: Opaque<"string">,
                 dataLabel: Opaque<"string">,
                 writtenAt: Uint<64>
                 ): Bytes<32> {
  const refId = deriveRefId(refCounter as Bytes<32>, kernel.self().bytes);
  assert(!references.member(disclose(refId)), "Reference already stored");

  // Persist the reference entry.
  const entry = ReferenceEntry { storageId,
                                 encryptionScheme,
                                 storageProvider,
                                 dataLabel,
                                 writtenAt };
  references.insert(disclose(refId), disclose(entry));

  // Increment after insertion so the next write gets a fresh refId.
  refCounter.increment(1);
  return refId;
}

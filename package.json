{
  "name": "dstorage-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "dStorage SDK — Privacy-first data layer for dApps",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/crypto && npm run build --workspace=packages/seed-providers && npm run build --workspace=packages/payment && npm run build --workspace=packages/storage && npm run build --workspace=packages/chain && npm run build --workspace=packages/core",
    "compile:contract": "compact compile packages/chain/src/adapters/midnight/contracts/DataRegistry.compact packages/chain/src/adapters/midnight/contracts/dataregistry/managed",
    "demo:run": "npm run --workspace=apps/demo copy-zk-artifacts && npm run dev --workspace=apps/demo",
    "demo-console:run": "npm run start --workspace=apps/demo-console",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src apps/*/src --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "overrides": {
    "bn.js": "5.2.3"
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "axios": "^1.13.6",
    "bn.js": "5.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.15.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^10.1.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}

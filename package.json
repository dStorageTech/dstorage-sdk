{
  "name": "dstorage-monorepo",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "description": "dStorage SDK — Privacy-first data layer for dApps",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/crypto && npm run build --workspace=packages/encryption && npm run build --workspace=packages/payment && npm run build --workspace=packages/storage && npm run build --workspace=packages/chain && npm run build --workspace=packages/core",
    "compile:contract": "compact compile packages/chain/src/adapters/midnight/contracts/DataRegistry.compact packages/chain/src/adapters/midnight/contracts/dataregistry/managed",
    "demo:run": "npm run build && npm run --workspace=apps/demo copy-zk-artifacts && npm run dev --workspace=apps/demo",
    "demo-console:run": "npm run start --workspace=apps/demo-console",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src apps/*/src --ext .ts,.tsx",
    "format": "prettier --write .",
    "check": "npm run format && npm run build && npm run test",
    "version:bump": "node tools/bump-version.mjs",
    "bundler-mock:run": "tsx tools/mock-bundler-server.ts",
    "clean": "find . -type d \\( -name node_modules -o -name dist \\) -prune -exec rm -rf {} +"
  },
  "overrides": {
    "arweave": "^2.1.0",
    "bn.js": "5.2.5",
    "@midnight-ntwrk/ledger-v8": "8.1.1",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.0",
    "elliptic": "6.6.1",
    "secp256k1": "5.0.2",
    "ws": "8.21.3",
    "uuid": "14.0.2",
    "axios": "^1.18.1",
    "esbuild": "0.28.2",
    "@dha-team/arbundles": {
      "elliptic": "6.6.1",
      "secp256k1": "5.0.2",
      "ws": "8.21.3"
    },
    "@midnight-ntwrk/wallet-sdk": {
      "@substrate/connect": "2.1.8"
    }
  },
  "dependencies": {
    "bn.js": "5.2.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "keccak@3.0.2": true,
    "keccak@3.0.4": true,
    "utf-8-validate@5.0.10": true,
    "utf-8-validate@6.0.6": true,
    "bigint-buffer@1.1.5": true,
    "bufferutil@4.1.0": true,
    "classic-level@3.0.0": true,
    "secp256k1@5.0.2": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.1": true,
    "msgpackr-extract@3.0.4": true
  }
}

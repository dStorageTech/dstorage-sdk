{
  "name": "dstorage-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "dStorage SDK — Privacy-first data layer for dApps",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/crypto && npm run build --workspace=packages/storage && npm run build --workspace=packages/chain && npm run build --workspace=packages/payment && npm run build --workspace=packages/core",
    "compile:contract": "compact compile packages/chain/src/adapters/midnight/contracts/DataRegistry.compact packages/chain/src/adapters/midnight/contracts/dataregistry/managed",
    "demo:run": "npm run dev --workspace=apps/demo",
    "demo-console:run": "npm run start --workspace=apps/demo-console",
    "example": "tsx examples/basic-flow.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src apps/*/src --ext .ts,.tsx"
  },
  "overrides": {
    "bn.js": "5.2.3"
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v7": "7.0.0",
    "axios": "^1.13.6",
    "bn.js": "5.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.14.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^3.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}

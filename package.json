{
  "name": "dstorage-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "dStorage SDK — Privacy-first data layer for dApps",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/crypto && npm run build --workspace=packages/encryption && npm run build --workspace=packages/payment && npm run build --workspace=packages/storage && npm run build --workspace=packages/chain && npm run build --workspace=packages/core",
    "compile:contract": "compact compile packages/chain/src/adapters/midnight/contracts/DataRegistry.compact packages/chain/src/adapters/midnight/contracts/dataregistry/managed",
    "demo:run": "npm run --workspace=apps/demo copy-zk-artifacts && npm run dev --workspace=apps/demo",
    "demo-console:run": "npm run start --workspace=apps/demo-console",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src apps/*/src --ext .ts,.tsx",
    "format": "prettier --write .",
    "check": "npm run format || npm run build && npm run test",
    "clean": "find . -type d \\( -name node_modules -o -name dist \\) -prune -exec rm -rf {} +"
  },
  "overrides": {
    "bn.js": "5.2.3"
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "axios": "^1.16.0",
    "bn.js": "5.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-js": "^2.5.0",
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}

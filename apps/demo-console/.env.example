# dStorage Console Demo — environment variables
#
# Set these to skip the interactive prompts at startup.
# Leave a variable unset (or blank) to be asked interactively instead.

# BIP-39 mnemonic (24 words minimum) or hex seed (64 or 128 hex chars).
# Shorter mnemonics are rejected — they carry too little entropy.
# Example mnemonic:
#DSTORAGE_SEED="<24 space-separated BIP-39 words>"
# Example hex seed — generate a real one, never type it by hand:
#   openssl rand -hex 32
#DSTORAGE_SEED="<64 hex chars>"

# Deployed DataRegistry contract address.
# Leave unset to auto-deploy a new contract on startup.
#DSTORAGE_CONTRACT_ADDRESS="contract_address_here"

# Base URL of the dStorage signing server (default: http://localhost:3000).
#DSTORAGE_SIGNING_SERVER_URL="https://api.example.com"

# Bearer token sent as the Authorization header to the signing server.
# Only used when answering "y" to the cloud services prompt.
#DSTORAGE_AUTH_TOKEN="your-token-here"

# Password for the demo PasswordEncryptionAdapter (second adapter, demonstrates multi-key wrapping).
# If unset, the startup prompt asks for one; leave the prompt blank to auto-generate a random password.
# Must be remembered to decrypt data when the mnemonic/seed is unavailable.
#DSTORAGE_DEMO_PASSWORD="change-me-before-use"

# Optional Midnight node / indexer endpoint overrides (default: public endpoints for the
# chosen network). Use these for a keyed provider; the URLs then contain your API key,
# so keep them in .env only (gitignored), never in source.
#DSTORAGE_NODE_HTTP="https://rpc.midnight-preprod.blockfrost.io?project_id=<your-key>"
#DSTORAGE_NODE_WS="wss://rpc.midnight-preprod.blockfrost.io?project_id=<your-key>"
#DSTORAGE_INDEXER_HTTP="https://midnight-preprod.blockfrost.io/api/v0?project_id=<your-key>"
#DSTORAGE_INDEXER_WS="wss://midnight-preprod.blockfrost.io/api/v0/ws?project_id=<your-key>"

# dStorage React Demo — environment variables
#
# Copy to .env and fill in the values.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.

# Bearer token pre-filled in the "Auth Token" field for managed payments.
# If unset, the field starts empty and must be entered manually.
#VITE_DSTORAGE_AUTH_TOKEN="your-token-here"

# Default password pre-filled in the "Demo Mode" encryption password field.
# If unset, the field starts empty and the Continue button is disabled until
# the user types a password. Set this to speed up local development.
#VITE_DEMO_PASSWORD="change-me-before-use"

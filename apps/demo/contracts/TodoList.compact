pragma language_version >= 0.16 && <= 0.18;

import CompactStandardLibrary;

export struct NoteEntry {
  storageId:       Bytes<64>;
  storageProvider: Bytes<16>;
  owner:           Bytes<64>;
  dataLabel:       Bytes<32>;
  createdAt:       Uint<64>;
}

export ledger notes:       Map<Bytes<32>, NoteEntry>;
export ledger noteCounter: Counter;
export ledger permissions: Map<Bytes<32>, Boolean>;

witness deriveNoteId(storageId: Bytes<64>, count: Uint<64>): Bytes<32>;

pure circuit permKey(refId: Bytes<32>, granteeHash: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([refId, granteeHash]);
}

export circuit storeReference(
  storageId:       Bytes<64>,
  storageProvider: Bytes<16>,
  owner:           Bytes<64>,
  dataLabel:       Bytes<32>
): Bytes<32> {
  noteCounter.increment(1);
  const count = noteCounter.read();
  const noteId = deriveNoteId(disclose(storageId), count);
  notes.insert(disclose(noteId), NoteEntry {
    storageId:       disclose(storageId),
    storageProvider: disclose(storageProvider),
    owner:           disclose(owner),
    dataLabel:       disclose(dataLabel),
    createdAt:       count as Uint<64>,
  });
  return disclose(noteId);
}

export circuit getReference(refId: Bytes<32>): NoteEntry {
  assert notes.member(disclose(refId)) "Note not found";
  return notes.lookup(disclose(refId));
}

export circuit grantAccess(refId: Bytes<32>, grantee: Bytes<64>): [] {
  assert notes.member(disclose(refId)) "Note not found";
  const key = permKey(disclose(refId), persistentHash<Bytes<64>>(disclose(grantee)));
  permissions.insert(key, true);
}

export circuit revokeAccess(refId: Bytes<32>, grantee: Bytes<64>): [] {
  const key = permKey(disclose(refId), persistentHash<Bytes<64>>(disclose(grantee)));
  permissions.insert(key, false);
}

export circuit hasAccess(refId: Bytes<32>, wallet: Bytes<64>): Boolean {
  if (!notes.member(disclose(refId))) { return false; }
  const entry = notes.lookup(disclose(refId));
  if (disclose(entry.owner == wallet)) { return true; }
  const key = permKey(disclose(refId), persistentHash<Bytes<64>>(disclose(wallet)));
  if (!permissions.member(key)) { return false; }
  return permissions.lookup(key);
}
